{
  "name": "kr-stock-widget",
  "version": "1.0.0",
  "description": "한국 주식 관심종목 데스크톱 위젯 (Electron + Yahoo Finance)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs",
    "check:sources": "node tests/sources-live.mjs",
    "dist": "electron build/make-icon.cjs && electron-builder --win"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^44.10.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.56.0",
    "rcedit": "^4.0.1"
  },
  "productName": "관심종목 위젯",
  "author": {
    "name": "Wuid0801"
  },
  "build": {
    "appId": "com.wuid0801.kr-stock-widget",
    "productName": "관심종목 위젯",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!docs/**",
      "!*.md",
      "!**/*.map",
      "!.superpowers/**",
      "!.*/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "관심종목 위젯"
    },
    "afterPack": "build/after-pack.cjs",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "artifactName": "KRStockWidget-Setup.exe"
  }
}
